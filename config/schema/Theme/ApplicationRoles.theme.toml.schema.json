{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "ApplicationRoles.theme.toml.schema.json",
    "title": "Application Semantic Role Assignments",
    "description": "Maps application theme tokens to palette-independent visual roles.",
    "$defs": {
        "role": {
            "type": "string",
            "enum": [
                "background",
                "foreground",
                "surface",
                "surface-foreground",
                "surface-raised",
                "surface-raised-foreground",
                "surface-light",
                "surface-midlight",
                "surface-mid",
                "surface-dark",
                "surface-hover",
                "surface-selection",
                "surface-inactive",
                "surface-input",
                "surface-control",
                "surface-window",
                "muted",
                "foreground-muted",
                "foreground-subtle",
                "foreground-faint",
                "foreground-overlay",
                "foreground-quiet",
                "disabled",
                "border",
                "border-strong",
                "shadow",
                "accent",
                "accent-primary",
                "accent-secondary",
                "accent-tertiary",
                "accent-warm",
                "accent-soft",
                "accent-cool",
                "accent-cyan",
                "accent-teal",
                "accent-foreground",
                "accent-contrast",
                "selection",
                "selection-foreground",
                "error",
                "error-foreground",
                "warning",
                "warning-foreground",
                "success",
                "success-foreground",
                "link",
                "link-visited",
                "tooltip",
                "tooltip-foreground",
                "placeholder",
                "caret",
                "syntax-annotation",
                "syntax-class",
                "syntax-comment",
                "syntax-entity",
                "syntax-constant",
                "syntax-function",
                "syntax-identifier",
                "syntax-keyword",
                "syntax-number",
                "syntax-operator",
                "syntax-parameter",
                "syntax-property",
                "syntax-punctuation",
                "syntax-regexp",
                "syntax-string",
                "syntax-tag",
                "syntax-type",
                "syntax-variable",
                "terminal-bright-red",
                "terminal-bright-green",
                "terminal-bright-yellow",
                "terminal-bright-blue",
                "terminal-bright-magenta",
                "terminal-bright-cyan"
            ]
        },
        "roleMap": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/roleAssignment" }
        },
        "roleAssignment": {
            "oneOf": [
                { "$ref": "#/$defs/role" },
                {
                    "type": "object",
                    "properties": {
                        "role": { "$ref": "#/$defs/role" },
                        "light-role": { "$ref": "#/$defs/role" },
                        "dark-role": { "$ref": "#/$defs/role" },
                        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                        "light-opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                        "dark-opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                        "mix": { "$ref": "#/$defs/role" },
                        "amount": { "type": "number", "minimum": 0, "maximum": 1 },
                        "light-amount": { "type": "number", "minimum": 0, "maximum": 1 },
                        "dark-amount": { "type": "number", "minimum": 0, "maximum": 1 },
                        "shade": { "type": "number", "minimum": -1, "maximum": 1 },
                        "light-shade": { "type": "number", "minimum": -1, "maximum": 1 },
                        "dark-shade": { "type": "number", "minimum": -1, "maximum": 1 },
                        "color-math": { "enum": ["byte-ratio"] }
                    },
                    "required": ["role"],
                    "additionalProperties": false
                }
            ]
        },
        "valueMap": {
            "type": "object",
            "additionalProperties": {
                "type": ["string", "integer", "number", "boolean"]
            }
        },
        "syntaxStyleMap": {
            "type": "object",
            "patternProperties": {
                "^.+\\.font_style$": { "enum": ["italic"] },
                "^.+\\.font_weight$": { "type": "integer", "minimum": 100, "maximum": 900 }
            },
            "additionalProperties": false
        },
        "nullFieldMap": {
            "type": "object",
            "additionalProperties": { "const": true }
        }
    },
    "type": "object",
    "properties": {
        "Zed": {
            "type": "object",
            "properties": {
                "Colors": { "$ref": "#/$defs/roleMap" },
                "Syntax": { "$ref": "#/$defs/roleMap" },
                "SyntaxStyles": { "$ref": "#/$defs/syntaxStyleMap" },
                "Terminal": { "$ref": "#/$defs/roleMap" },
                "Players": { "$ref": "#/$defs/roleMap" },
                "Accents": { "$ref": "#/$defs/roleMap" },
                "Null": { "$ref": "#/$defs/nullFieldMap" },
                "Settings": { "$ref": "#/$defs/valueMap" }
            },
            "additionalProperties": false
        },
        "VSCode": {
            "type": "object",
            "properties": {
                "Colors": { "$ref": "#/$defs/roleMap" },
                "Tokens": { "$ref": "#/$defs/roleMap" },
                "SemanticTokens": { "$ref": "#/$defs/roleMap" }
            },
            "additionalProperties": false
        },
        "IDEA": {
            "type": "object",
            "properties": {
                "UI": { "$ref": "#/$defs/roleMap" },
                "Colors": { "$ref": "#/$defs/roleMap" },
                "Attributes": { "$ref": "#/$defs/roleMap" },
                "Icons": { "$ref": "#/$defs/roleMap" },
                "Settings": { "$ref": "#/$defs/valueMap" },
                "Styles": { "$ref": "#/$defs/valueMap" }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
