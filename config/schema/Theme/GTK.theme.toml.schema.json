{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "GTK.theme.toml.schema.json",
    "title": "GTK UI color-family assignments",
    "description": "Maps GTK UI parts to semantic roles, which each theme resolves through its palette.",
    "type": "object",
    "properties": {
        "window-background": { "$ref": "#/$defs/role" },
        "window-foreground": { "$ref": "#/$defs/role" },
        "view-background": { "$ref": "#/$defs/role" },
        "view-foreground": { "$ref": "#/$defs/role" },
        "surface-background": { "$ref": "#/$defs/role" },
        "surface-foreground": { "$ref": "#/$defs/role" },
        "raised-background": { "$ref": "#/$defs/role" },
        "raised-foreground": { "$ref": "#/$defs/role" },
        "muted-foreground": { "$ref": "#/$defs/role" },
        "disabled-foreground": { "$ref": "#/$defs/role" },
        "border": { "$ref": "#/$defs/role" },
        "border-strong": { "$ref": "#/$defs/role" },
        "shadow": { "$ref": "#/$defs/role" },
        "control-accent": { "$ref": "#/$defs/role" },
        "control-accent-foreground": { "$ref": "#/$defs/role" },
        "selection-background": { "$ref": "#/$defs/role" },
        "selection-foreground": { "$ref": "#/$defs/role" },
        "error": { "$ref": "#/$defs/role" },
        "error-foreground": { "$ref": "#/$defs/role" },
        "warning": { "$ref": "#/$defs/role" },
        "warning-foreground": { "$ref": "#/$defs/role" },
        "success": { "$ref": "#/$defs/role" },
        "success-foreground": { "$ref": "#/$defs/role" },
        "link": { "$ref": "#/$defs/role" },
        "link-visited": { "$ref": "#/$defs/role" },
        "placeholder-text": { "$ref": "#/$defs/role" },
        "tooltip-background": { "$ref": "#/$defs/role" },
        "tooltip-foreground": { "$ref": "#/$defs/role" },
        "title-close": { "$ref": "#/$defs/role" },
        "title-minimize": { "$ref": "#/$defs/role" },
        "title-maximize": { "$ref": "#/$defs/role" },
        "category-create": { "$ref": "#/$defs/role" },
        "category-develop": { "$ref": "#/$defs/role" },
        "category-learn": { "$ref": "#/$defs/role" },
        "category-play": { "$ref": "#/$defs/role" },
        "category-socialize": { "$ref": "#/$defs/role" },
        "category-work": { "$ref": "#/$defs/role" },
        "palette-error": { "$ref": "#/$defs/role" },
        "palette-warning": { "$ref": "#/$defs/role" },
        "palette-success": { "$ref": "#/$defs/role" },
        "palette-link": { "$ref": "#/$defs/role" },
        "palette-accent": { "$ref": "#/$defs/role" },
        "palette-neutral": { "$ref": "#/$defs/role" }
    },
    "required": [
        "window-background",
        "window-foreground",
        "view-background",
        "view-foreground",
        "surface-background",
        "surface-foreground",
        "raised-background",
        "raised-foreground",
        "muted-foreground",
        "disabled-foreground",
        "border",
        "border-strong",
        "shadow",
        "control-accent",
        "control-accent-foreground",
        "selection-background",
        "selection-foreground",
        "error",
        "error-foreground",
        "warning",
        "warning-foreground",
        "success",
        "success-foreground",
        "link",
        "link-visited",
        "placeholder-text",
        "tooltip-background",
        "tooltip-foreground",
        "title-close",
        "title-minimize",
        "title-maximize",
        "category-create",
        "category-develop",
        "category-learn",
        "category-play",
        "category-socialize",
        "category-work",
        "palette-error",
        "palette-warning",
        "palette-success",
        "palette-link",
        "palette-accent",
        "palette-neutral"
    ],
    "additionalProperties": false,
    "$defs": {
        "role": {
            "type": "string",
            "enum": [
                "background", "foreground", "surface", "surface-foreground",
                "surface-raised", "surface-raised-foreground", "surface-light",
                "surface-midlight", "surface-mid", "surface-dark", "muted",
                "foreground-muted", "disabled", "border", "border-strong", "shadow",
                "accent", "accent-foreground", "selection", "selection-foreground",
                "error", "error-foreground", "warning", "warning-foreground", "success",
                "success-foreground", "link", "link-visited", "tooltip",
                "tooltip-foreground", "placeholder"
            ]
        }
    }
}
