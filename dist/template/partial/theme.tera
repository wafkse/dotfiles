{# ============================================================================ #}
{# THEME ACCESS & OVERRIDE MACROS                 #}
{# ============================================================================ #}

{# 2. BASE COLOR #}
{% macro Color(ThemeTree, ColorName) -%}
    {%- set TargetThemeName = ThemeTree.default -%}
    {%- if ThemeTree.name is defined and ThemeTree.name | length > 0 -%}
        {%- set TargetThemeName = ThemeTree.name -%}
    {%- endif -%}

    {%- if ThemeTree[TargetThemeName] is defined and ThemeTree[TargetThemeName].Palette is defined -%}
        {%- for PaletteItem in ThemeTree[TargetThemeName].Palette -%}
            {%- if PaletteItem.name == ColorName -%}
                {{- PaletteItem.color -}}
            {%- endif -%}
        {%- endfor -%}
    {%- else -%}
        {{- ThemeTree.placeholder -}}
    {%- endif -%}
{%- endmacro Color %}


{# 3. APPLICATION OVERRIDE (STRING) #}
{% macro AppString(ThemeTree, AppName, KeyName) -%}
    {%- set TargetThemeName = ThemeTree.default -%}
    {%- if ThemeTree.name is defined and ThemeTree.name | length > 0 -%}
        {%- set TargetThemeName = ThemeTree.name -%}
    {%- endif -%}

    {%- if ThemeTree[TargetThemeName] is defined and ThemeTree[TargetThemeName].Override is defined and ThemeTree[TargetThemeName].Override[AppName] is defined and ThemeTree[TargetThemeName].Override[AppName][KeyName] is defined -%}
        {%- set TargetColorName = ThemeTree[TargetThemeName].Override[AppName][KeyName] -%}

        {# Print directly to avoid block-scoping bugs #}
        {%- for PaletteItem in ThemeTree[TargetThemeName].Palette -%}
            {%- if PaletteItem.name == TargetColorName -%}
                {{- PaletteItem.color -}}
            {%- endif -%}
        {%- endfor -%}
    {%- else -%}
        {{- ThemeTree.placeholder -}}
    {%- endif -%}
{%- endmacro AppString %}


{# 4. APPLICATION OVERRIDE (ARRAY) #}
{% macro AppArray(ThemeTree, AppName, ArrayName, Index) -%}
    {%- set TargetThemeName = ThemeTree.default -%}
    {%- if ThemeTree.name is defined and ThemeTree.name | length > 0 -%}
        {%- set TargetThemeName = ThemeTree.name -%}
    {%- endif -%}

    {%- if ThemeTree[TargetThemeName] is defined and ThemeTree[TargetThemeName].Override is defined and ThemeTree[TargetThemeName].Override[AppName] is defined and ThemeTree[TargetThemeName].Override[AppName][ArrayName] is defined and ThemeTree[TargetThemeName].Override[AppName][ArrayName][Index] is defined -%}
        {%- set TargetColorName = ThemeTree[TargetThemeName].Override[AppName][ArrayName][Index] -%}

        {# Print directly to avoid block-scoping bugs #}
        {%- for PaletteItem in ThemeTree[TargetThemeName].Palette -%}
            {%- if PaletteItem.name == TargetColorName -%}
                {{- PaletteItem.color -}}
            {%- endif -%}
        {%- endfor -%}
    {%- else -%}
        {{- ThemeTree.placeholder -}}
    {%- endif -%}
{%- endmacro AppArray %}


{# 5. APPLICATION OVERRIDE (GRADIENT) #}
{% macro AppGradient(ThemeTree, AppName, KeyName) -%}
    {%- set TargetThemeName = ThemeTree.default -%}
    {%- if ThemeTree.name is defined and ThemeTree.name | length > 0 -%}
        {%- set TargetThemeName = ThemeTree.name -%}
    {%- endif -%}

    {%- if ThemeTree[TargetThemeName] is defined and ThemeTree[TargetThemeName].Override is defined and ThemeTree[TargetThemeName].Override[AppName] is defined and ThemeTree[TargetThemeName].Override[AppName][KeyName] is defined -%}
        {%- set GradObj = ThemeTree[TargetThemeName].Override[AppName][KeyName] -%}

        {# Inject the direct print outputs strictly into the gradient attributes #}
        from="{%- for item in ThemeTree[TargetThemeName].Palette -%}{%- if item.name == GradObj.from -%}{{- item.color -}}{%- endif -%}{%- endfor -%}" to="{%- for item in ThemeTree[TargetThemeName].Palette -%}{%- if item.name == GradObj.to -%}{{- item.color -}}{%- endif -%}{%- endfor -%}"

        {%- if GradObj.angle is defined %} angle={{ GradObj.angle }}{% endif -%}
        {%- if GradObj["relative-to"] is defined %} relative-to="{{ GradObj["relative-to"] }}"{% endif -%}
        {%- if GradObj.in is defined %} in="{{ GradObj.in }}"{% endif -%}
    {%- endif -%}
{%- endmacro AppGradient %}
