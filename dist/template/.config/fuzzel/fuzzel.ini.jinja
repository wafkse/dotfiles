selection={{ ThemeApp(Theme, 'Fuzzel', 'selection') | replace("#", "") }}ff
selection-text={{ ThemeApp(Theme, 'Fuzzel', 'selection-text') | replace("#", "") }}ff
selection-match={{ ThemeApp(Theme, 'Fuzzel', 'selection-match') | replace("#", "") }}ff
placeholder={{ ThemeApp(Theme, 'Fuzzel', 'placeholder') | replace("#", "") }}ff
prompt={{ ThemeApp(Theme, 'Fuzzel', 'prompt') | replace("#", "") }}ff
input={{ ThemeApp(Theme, 'Fuzzel', 'input') | replace("#", "") }}ff
counter={{ ThemeApp(Theme, 'Fuzzel', 'counter') | replace("#", "") }}ff
border={{ ThemeApp(Theme, 'Fuzzel', 'border') | replace("#", "") }}ff

[border]
{{ EmitRaw(Tree=Config, SubTree="border", Key="width", Default=1) }}
{{ EmitRaw(Tree=Config, SubTree="border", Key="radius", Default=10) }}
