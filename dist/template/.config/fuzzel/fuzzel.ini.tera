{% import "partial/theme.tera" as ThemeMacros %}

{% set ThemeRoot = Theme %}
{% set Config = Fuzzel %}

{# Emits standard key=value. Safely traverses Tree -> SubTree -> Key #}
{% macro EmitRaw(Tree, SubTree, Key, Default) -%}
    {%- set Val = Default -%}
    {%- if Tree is defined and Tree[SubTree] is defined -%}
        {%- if Tree[SubTree][Key] is defined -%}
            {%- set Val = Tree[SubTree][Key] -%}
        {%- endif -%}
    {%- endif -%}
    {{ Key }}={{ Val }}
{%- endmacro EmitRaw %}

{# Emits key=value only if it explicitly exists (no default) #}
{% macro EmitOptionalRaw(Tree, SubTree, Key) -%}
    {%- if Tree is defined and Tree[SubTree] is defined -%}
        {%- if Tree[SubTree][Key] is defined -%}
            {{ Key }}={{ Tree[SubTree][Key] }}
        {%- endif -%}
    {%- endif -%}
{%- endmacro EmitOptionalRaw %}

{# Emits key="value" inside double quotes #}
{% macro EmitQuoted(Tree, SubTree, Key, Default) -%}
    {%- set Val = Default -%}
    {%- if Tree is defined and Tree[SubTree] is defined -%}
        {%- if Tree[SubTree][Key] is defined -%}
            {%- set Val = Tree[SubTree][Key] -%}
        {%- endif -%}
    {%- endif -%}
    {{ Key }}="{{ Val }}"
{%- endmacro EmitQuoted %}

{# Translates true/false to yes/no for Fuzzel INI #}
{% macro EmitBool(Tree, SubTree, Key, Default) -%}
    {%- set Val = Default -%}
    {%- if Tree is defined and Tree[SubTree] is defined -%}
        {%- if Tree[SubTree][Key] is defined -%}
            {%- set Val = Tree[SubTree][Key] -%}
        {%- endif -%}
    {%- endif -%}
    {{ Key }}={% if Val %}yes{% else %}no{% endif %}
{%- endmacro EmitBool %}


# ==============================================================================
# Fuzzel Configuration File
# Generated dynamically via miragectl
# ==============================================================================

[main]
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="font", Default="monospace") }}
{{ self::EmitBool(Tree=Config, SubTree="main", Key="use-bold", Default=false) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="dpi-aware", Default="auto") }}
{{ self::EmitQuoted(Tree=Config, SubTree="main", Key="prompt", Default="> ") }}
{{ self::EmitQuoted(Tree=Config, SubTree="main", Key="placeholder", Default="") }}
{{ self::EmitBool(Tree=Config, SubTree="main", Key="icons-enabled", Default=true) }}
{{ self::EmitOptionalRaw(Tree=Config, SubTree="main", Key="icon-theme") }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="match-mode", Default="fzf") }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="lines", Default=15) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="width", Default=30) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="horizontal-pad", Default=40) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="vertical-pad", Default=8) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="inner-pad", Default=0) }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="layer", Default="overlay") }}
{{ self::EmitRaw(Tree=Config, SubTree="main", Key="anchor", Default="center") }}
{{ self::EmitBool(Tree=Config, SubTree="main", Key="exit-on-keyboard-focus-loss", Default=true) }}

[colors]
background={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='background') | replace(from="#", to="") }}ff
text={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='text') | replace(from="#", to="") }}ff
match={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='match') | replace(from="#", to="") }}ff
selection={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='selection') | replace(from="#", to="") }}ff
selection-text={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='selection-text') | replace(from="#", to="") }}ff
selection-match={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='selection-match') | replace(from="#", to="") }}ff
placeholder={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='placeholder') | replace(from="#", to="") }}ff
prompt={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='prompt') | replace(from="#", to="") }}ff
input={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='input') | replace(from="#", to="") }}ff
counter={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='counter') | replace(from="#", to="") }}ff
border={{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Fuzzel', KeyName='border') | replace(from="#", to="") }}ff

[border]
{{ self::EmitRaw(Tree=Config, SubTree="border", Key="width", Default=1) }}
{{ self::EmitRaw(Tree=Config, SubTree="border", Key="radius", Default=10) }}
{{ self::EmitRaw(Tree=Config, SubTree="border", Key="selection-radius", Default=0) }}

[dmenu]
{{ self::EmitRaw(Tree=Config, SubTree="dmenu", Key="mode", Default="text") }}
{{ self::EmitBool(Tree=Config, SubTree="dmenu", Key="exit-immediately-if-empty", Default=false) }}
