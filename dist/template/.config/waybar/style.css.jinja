/* ==========================================================================
   General Setup
   ========================================================================== */

* {
    font-family: "JetBrainsMono Nerd Font", sans-serif;
    font-weight: bold;
    min-height: 1em;
    font-size: 0.125in;
    box-shadow: none;
    border: none;
    text-shadow: none;
}

/* === Main Background === */
window#waybar {
    background: transparent;
}

/* === Tooltip === */
tooltip {
    background: @tooltip-background;
    border: solid;
    border-width: 0.125em;
    border-radius: 1em;
    border-color: @tooltip-border;
}

tooltip label {
    color: @tooltip-foreground;
    font-weight: normal;
    margin: 0.125em;
}

/* === Pill Modules Base === */
#workspaces,
#idle_inhibitor,
#privacy,
#window,
#load,
#cpu,
#memory,
#temperature,
#tray,
#pulseaudio,
#bluetooth,
#network,
#clock {
    border-radius: 1em;
    margin: 0.25em;
    padding: 0.75em;
    opacity: 1;
}

/* ==========================================================================
   Modules
   ========================================================================== */

/* == Workspaces == */
#workspaces {
    background: @workspace-background;
    padding: 0.25em;
}

#workspaces button {
    color: @workspace-foreground;
    min-width: 1em;
    border-radius: 2em;
    transition: none;
}

#workspaces button:hover {
    color: @workspace-button-hover-foreground;
    background: @workspace-button-hover-background;
}

#workspaces button.active {
    color: @workspace-button-select-foreground;
    background: @workspace-button-select-background;
}

/* == Idle Inhibitor == */
#idle_inhibitor {
    background: @idle-background;
    color: @idle-foreground;
}

/* == Privacy == */
#privacy {
    background: @privacy-background;
    color: @privacy-foreground;
}

/* == Window == */
#window {
    background: @window-background;
    color: @window-foreground;
}

/* == Hardware Stats == */
#load {
    background: @load-background;
    color: @load-foreground;
}

#cpu {
    background: @cpu-background;
    color: @cpu-foreground;
}

#memory {
    background: @memory-background;
    color: @memory-foreground;
}

#memory.warning {
    color: @memory-state-warning;
}
#memory.critical {
    color: @memory-state-critical;
}

#temperature {
    background: @temp-background;
    color: @temp-foreground;
}

#temperature.critical {
    color: @temp-state-critical;
}

/* == Tray == */
#tray {
    background: @tray-background;
    color: @tray-foreground;
}

/* == Media & Connectivity == */
#pulseaudio {
    background: @audio-background;
    color: @audio-foreground;
}

#pulseaudio:hover {
    background: @audio-hover-background;
}

#bluetooth {
    background: @bluetooth-background;
    color: @bluetooth-foreground;
}

#network {
    background: @network-background;
    color: @network-foreground;
}

/* == Time == */
#clock {
    background: @clock-background;
    color: @clock-foreground;
}

