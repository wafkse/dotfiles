# Configuration for Ghostty

{% set Config = Ghostty %}

{% for SectionName, SectionTree in Config | items %}
# --- {{ SectionName | upper }} ---
{%- if SectionName == "Keybinds" %}
# (Keybinds are emitted using the 'Keybind' prefix)
{%- for KeybindTrigger, KeybindAction in SectionTree | items %}
Keybind = {{ KeybindTrigger }}={{ KeybindAction }}
{%- endfor %}
{%- else %}
{%- for Key, Value in SectionTree | items %}
    {%- if Value is sequence %}
        {%- for item in Value %}
{{ Key }} = {{ item }}
        {%- endfor %}
    {%- elif Value is string %}
        {# Output string normally (Ghostty supports quotes, but raw is safer for font names) #}
{{ Key }} = {{ Value }}
    {%- elif Value is number %}
        {# Numbers (checked before booleans: minijinja coerces 1 == true) #}
{{ Key }} = {{ Value }}
    {%- else %}
        {# Ghostty expects literal true/false strings for booleans #}
{{ Key }} = {% if Value %}true{% else %}false{% endif %}
    {%- endif %}
{%- endfor %}
{%- endif %}

{% endfor %}

# We include the dedicated theme configuration file generated by the color engine.
theme = default
