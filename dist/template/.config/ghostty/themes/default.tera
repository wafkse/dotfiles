{%- import "partial/theme.tera" as ThemeMacros -%}

{#- Grab the root Theme object from the universe -#}
{%- set ThemeRoot = Theme -%}

{% for i in range(end=16) -%}
palette = {{ i }}={{ ThemeMacros::AppArray(ThemeTree=ThemeRoot, AppName='Ghostty', ArrayName='palette', Index=i) }}
{% endfor %}
background = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='background') }}
foreground = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='foreground') }}
cursor-color = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='cursor-color') }}
cursor-text = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='cursor-text') }}
selection-background = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='selection-background') }}
selection-foreground = {{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Ghostty', KeyName='selection-foreground') }}
