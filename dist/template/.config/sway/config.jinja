{# ==================== MACROS ==================== #}

{% macro EmitClientColors(ThemeTree, AppName, ClassName) -%}
client.{{ ClassName }} {{ ThemeApp(ThemeTree, AppName, ClassName ~ ".border") }} {{ ThemeApp(ThemeTree, AppName, ClassName ~ ".background") }} {{ ThemeApp(ThemeTree, AppName, ClassName ~ ".text") }} {{ ThemeApp(ThemeTree, AppName, ClassName ~ ".indicator") }} {{ ThemeApp(ThemeTree, AppName, ClassName ~ ".child_border") }}
{%- endmacro %}

{# ==================== CONFIGURATION ==================== #}

# Sway configuration generated from TOML

# --- VARIABLES ---
{% if Sway.Floating is defined and Sway.Floating.modifier is defined %}set $mod {{ Sway.Floating.modifier }}{% else %}set $mod Mod4{% endif %}

{% if Sway.Input is defined -%}
# --- INPUT ---
{% for DeviceIdentifier, Settings in Sway.Input | items -%}
input "{{ DeviceIdentifier }}" {
    {% if Settings.xkb_layout is defined %}xkb_layout {{ Settings.xkb_layout }}{% endif %}
    {% if Settings.xkb_variant is defined %}xkb_variant {{ Settings.xkb_variant }}{% endif %}
    {% if Settings.xkb_options is defined %}xkb_options {{ Settings.xkb_options }}{% endif %}
    {% if Settings.xkb_numlock is defined %}xkb_numlock {{ Settings.xkb_numlock }}{% endif %}
    {% if Settings.tap is defined %}tap {{ Settings.tap }}{% endif %}
    {% if Settings.natural_scroll is defined %}natural_scroll {{ Settings.natural_scroll }}{% endif %}
    {% if Settings.pointer_accel is defined %}pointer_accel {{ Settings.pointer_accel }}{% endif %}
    {% if Settings.accel_profile is defined %}accel_profile {{ Settings.accel_profile }}{% endif %}
}
{% endfor %}
{%- endif %}

{% if Sway.Focus is defined -%}
# --- FOCUS ---
{% if Sway.Focus.follow_mouse is defined %}focus_follows_mouse {{ Sway.Focus.follow_mouse }}{% endif %}
{% if Sway.Focus.mouse_warping is defined %}mouse_warping {{ Sway.Focus.mouse_warping }}{% endif %}
{%- endif %}

{% if Sway.Output is defined -%}
# --- OUTPUT ---
{% for OutputIdentifier, Settings in Sway.Output | items -%}
output "{{ OutputIdentifier }}" {
    {% if Settings.mode is defined %}mode {{ Settings.mode }}{% endif %}
    {% if Settings.pos is defined %}pos {{ Settings.pos }}{% endif %}
    {% if Settings.res is defined %}res {{ Settings.res }}{% endif %}
    {% if Settings.scale is defined %}scale {{ Settings.scale }}{% endif %}
    {% if Settings.bg is defined %}bg {{ Settings.bg }}{% endif %}
    {% if Settings.transform is defined %}transform {{ Settings.transform }}{% endif %}
    {% if Settings.adaptive_sync is defined %}adaptive_sync {{ Settings.adaptive_sync }}{% endif %}
    {% if Settings.allow_tearing is defined %}allow_tearing {{ Settings.allow_tearing }}{% endif %}
    {% if Settings.max_frame_time is defined %}max_frame_time {{ Settings.max_frame_time }}{% endif %}
}
{% endfor %}
{%- endif %}

{% if Sway.Gaps is defined -%}
# --- GAPS ---
{% if Sway.Gaps.inner is defined %}gaps inner {{ Sway.Gaps.inner }}{% endif %}
{% if Sway.Gaps.outer is defined %}gaps outer {{ Sway.Gaps.outer }}{% endif %}
{%- endif %}

{% if Sway.Window is defined -%}
# --- WINDOW ---
{% if Sway.Window.border is defined %}default_border {{ Sway.Window.border }} {{ Sway.Window.border_size | default(2) }}{% endif %}
{# NOTE: A `pixel`/`none` default_border already removes titlebars; Sway has no #}
{# standalone titlebar toggle, so `titlebar = false` is honored via the border. #}
{%- endif %}

{% if Sway.Floating is defined -%}
# --- FLOATING ---
{% if Sway.Floating.modifier is defined %}floating_modifier {{ Sway.Floating.modifier }}{% endif %}
{% if Sway.Floating.border is defined %}default_floating_border {{ Sway.Floating.border }} {{ Sway.Floating.border_size | default(2) }}{% endif %}
{%- endif %}

{% if Sway.WindowRules is defined -%}
# --- WINDOW RULES ---
{% for RuleName, RuleTree in Sway.WindowRules | items -%}
for_window [{% if RuleTree.match.app_id is defined %}app_id="{{ RuleTree.match.app_id }}" {% endif %}{% if RuleTree.match.class is defined %}class="{{ RuleTree.match.class }}" {% endif %}{% if RuleTree.match.instance is defined %}instance="{{ RuleTree.match.instance }}" {% endif %}{% if RuleTree.match.title is defined %}title="{{ RuleTree.match.title }}" {% endif %}{% if RuleTree.match.floating is defined %}floating {% endif %}{% if RuleTree.match.tiling is defined %}tiling {% endif %}] {% if RuleTree.command is string %}{{ RuleTree.command }}{% else %}{% for Command in RuleTree.command %}{{ Command }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
{% endfor %}
{%- endif %}

{% if Sway.Startup is defined -%}
# --- STARTUP ---
{% if Sway.Startup.exec is defined %}{% for Command in Sway.Startup.exec %}exec {{ Command }}
{% endfor %}{% endif %}
{% if Sway.Startup.exec_always is defined %}{% for Command in Sway.Startup.exec_always %}exec_always {{ Command }}
{% endfor %}{% endif %}
{%- endif %}

{% if Sway.Keybinds is defined -%}
# --- KEYBINDS ---
{% for HotkeyName, BindTree in Sway.Keybinds | items -%}
bindsym{% if BindTree.locked is defined and BindTree.locked %} --locked{% endif %}{% if BindTree.no_repeat is defined and BindTree.no_repeat %} --no-repeat{% endif %}{% if BindTree.release is defined and BindTree.release %} --release{% endif %} {{ HotkeyName }} {% if BindTree.spawn is defined %}exec {% for Argument in BindTree.spawn %}{{ Argument }}{% if not loop.last %} {% endif %}{% endfor %}{% elif BindTree.spawn_sh is defined %}exec {{ BindTree.spawn_sh }}{% elif BindTree.command is defined %}{{ BindTree.command }}{% endif %}
{% endfor %}
{%- endif %}

# --- THEME ---
{% set ThemeRoot = Theme -%}
{{ EmitClientColors(ThemeTree=ThemeRoot, AppName='Sway', ClassName='focused') }}
{{ EmitClientColors(ThemeTree=ThemeRoot, AppName='Sway', ClassName='focused_inactive') }}
{{ EmitClientColors(ThemeTree=ThemeRoot, AppName='Sway', ClassName='unfocused') }}
{{ EmitClientColors(ThemeTree=ThemeRoot, AppName='Sway', ClassName='urgent') }}
{{ EmitClientColors(ThemeTree=ThemeRoot, AppName='Sway', ClassName='placeholder') }}

output "*" bg {{ ThemeApp(ThemeRoot, 'Sway', 'background') }} solid_color

