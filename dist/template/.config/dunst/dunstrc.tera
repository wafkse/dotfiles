{% import "partial/theme.tera" as ThemeMacros %}
{% set ThemeRoot = Theme %}
{% set Config = Dunst %}

# ==============================================================================
# Configuration for Dunst
# ==============================================================================

{% for SectionName, SectionTree in Config %}
# --- {{ SectionName | upper }} ---
[{{ SectionName }}]
{%- for Key, Value in SectionTree %}
    {%- if Value is iterable %}
        {%- for item in Value %}
{{ Key }} = "{{ item }}"
        {%- endfor %}
    {%- elif Value == true or Value == false %}
        {# Dunst expects literal true/false strings for booleans #}
{{ Key }} = {% if Value %}true{% else %}false{% endif %}
    {%- elif Value is string %}
        {# Dunst strictly requires quotes for strings to prevent '#' from being parsed as a comment #}
{{ Key }} = "{{ Value }}"
    {%- else %}
        {# Numbers #}
{{ Key }} = {{ Value }}
    {%- endif %}
{%- endfor %}

{# --- Dynamically Inject Theme Colors Based on Section --- #}
{%- if SectionName == "global" %}
separator_color = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='global-separator') }}"
{%- elif SectionName == "urgency_low" %}
background = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='low-background') }}"
foreground = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='low-foreground') }}"
frame_color = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='low-frame') }}"
highlight = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='low-highlight') }}"
{%- elif SectionName == "urgency_normal" %}
background = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='normal-background') }}"
foreground = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='normal-foreground') }}"
frame_color = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='normal-frame') }}"
highlight = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='normal-highlight') }}"
{%- elif SectionName == "urgency_critical" %}
background = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='critical-background') }}"
foreground = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='critical-foreground') }}"
frame_color = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='critical-frame') }}"
highlight = "{{ ThemeMacros::AppString(ThemeTree=ThemeRoot, AppName='Dunst', KeyName='critical-highlight') }}"
{%- endif %}

{% endfor %}
